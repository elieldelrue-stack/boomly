# Copiez ce fichier en ".env.local" (sur votre ordinateur) et remplissez les valeurs.
# Sur Vercel : Project > Settings > Environment Variables.
# Ne mettez JAMAIS de vraies valeurs dans ce fichier-ci : il est publié sur GitHub.

# Adresse du site (facultatif sur Vercel : déduite automatiquement si vide)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète : serveur uniquement, ne jamais la partager
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (mode TEST : les clés commencent par sk_test_ / pk_test_) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Resend (e-mails) ---
RESEND_API_KEY=
EMAIL_FROM="Boomly <onboarding@resend.dev>"

# Adresse qui reçoit les alertes (paiement anormal, etc.)
ADMIN_ALERT_EMAIL=

# Ne JAMAIS mettre "on" tant que le passage en mode réel n'a pas été décidé.
STRIPE_LIVE_MODE=
